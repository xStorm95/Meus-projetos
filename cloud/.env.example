# ---------------------------------------------------------------
# Banco de dados PostgreSQL na nuvem (Neon, Supabase, Vercel
# Postgres, Railway, RDS...). Copie para .env.local em dev e
# configure nas "Environment Variables" do projeto na Vercel.
# ---------------------------------------------------------------
# Neon (recomendado): https://neon.tech  ->  Connection string
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Opcional: quantas conexões o pool abre por instância serverless
DB_POOL_MAX=3

# Opcional: origem usada apenas por scripts de teste local
APP_URL="http://localhost:3001"
