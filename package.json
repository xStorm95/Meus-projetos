{
  "name": "passarela-erp",
  "version": "1.0.0",
  "private": true,
  "description": "PASSARELA ERP - Sistema de gestão (ERP) completo para varejo de moda",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/migrate-build.mjs && next build",
    "start": "node scripts/start.mjs",
    "db:server": "tsx scripts/db-server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:demo": "tsx scripts/seed.ts --demo",
    "db:reset": "tsx scripts/reset.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "web:build": "node web/build.js",
    "web:test": "node --test web/tests/core.test.js web/tests/store.test.js && node web/tests/e2e.test.js && node web/tests/cash.test.js && node web/tests/file.test.js",
    "web:serve": "node web/serve.js",
    "dev:online": "node scripts/dev-online.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.44.7",
    "jose": "^6.2.15",
    "lucide-react": "^0.470.0",
    "next": "15.5.29",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.64.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.6",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
