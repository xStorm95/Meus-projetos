# ==========================================================
# PASSARELA ERP - exemplo de configuração de ambiente
# Copie para .env e ajuste. NUNCA comite o arquivo .env.
# ==========================================================

# --- Banco de dados (PostgreSQL 13+) ---
# Produção: use um PostgreSQL gerenciado (Neon, Supabase, RDS, etc.)
#
# NEON (recomendado): copie em neon.tech → Connect → "Pooled connection".
# A string termina com ?sslmode=require e tem "-pooler" no endereço.
#   DATABASE_URL="postgresql://neondb_owner:SENHA@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
#
# Local (desenvolvimento): npm run db:server
DATABASE_URL="postgresql://neondb_owner:npg_L8yhljTr4pIa@ep-icy-surf-b62xyfhf-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Máximo de conexões no pool da aplicação (no Neon use 5)
DB_POOL_MAX="10"

# --- Segurança / Sessão ---
# Gere com: openssl rand -base64 48
AUTH_SECRET="passarela-moda-2026-x7k9pQ2mL5vR8tY4nB1sW6z"
# Tempo de vida da sessão em horas
SESSION_TTL_HOURS="12"

# --- Aplicação ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Modo banco local embutido (apenas desenvolvimento/demonstração) ---
# O sandbox/dev pode rodar um PostgreSQL real em WASM via PGlite.
# Em produção NÃO use isso: aponte DATABASE_URL para um PostgreSQL real.
USE_EMBEDDED_PG="true"
# Acesso automático para avaliação (NUNCA use "true" em produção)
DEMO_AUTO_LOGIN="true"
EMBEDDED_PG_PORT="5432"
EMBEDDED_PG_DIR="./.pgdata"

# --- Integração fiscal (opcional) ---
# Provedor fiscal autorizado. Sem estas chaves o sistema opera apenas em HOMOLOGAÇÃO
# com transmissão simulada local, claramente sinalizada na interface.
FISCAL_PROVIDER=""
FISCAL_API_KEY=""
FISCAL_ENVIRONMENT="homologation"

# --- WhatsApp Business Cloud API (opcional) ---
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Uploads / logo ---
UPLOAD_DIR="./public/uploads"

# Comparativo entre lojas (opcional).
# Quem estiver nesta lista (separada por vírgula) vê a comparação de totais
# entre TODAS as lojas no painel /paineis. Sem a variável, o acesso fica com o
# e-mail do dono da loja mais antiga. Deixe vazio em instalações de uma loja só.
PLATFORM_ADMIN_EMAILS=""
